  flex-direction: column;
  align-items: center;
  background-color: #000000;
  padding: 20px;
}

.page-title {
  font-size: 20px;
  font-weight: bold;
  color: #ffffff;
  margin-top: 6px;
}

.summary {
  flex-direction: row;
  justify-content: center;
  margin-top: 12px;
  margin-bottom: 8px;
}

.summary-text {
  font-size: 14px;
  color: #aaaaaa;
  margin: 0 8px;
}

.empty-tip {
  font-size: 14px;
  color: #4CAF50;
  margin-top: 30px;
  text-align: center;
}

.distraction-list {
  width: 100%;
  flex: 1;
  margin-top: 8px;
}

.list-item {
  flex-direction: column;
  background-color: #1A1A1A;
  border-radius: 8px;
  padding: 10px 14px;
  margin-bottom: 8px;
}

.item-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
}

.item-index {
  font-size: 14px;
  font-weight: bold;
  color: #4CAF50;
}

.item-type {
  font-size: 11px;
  padding: 2px 6px;
  border-radius: 4px;
}

.type-physical {
  color: #FF6B6B;
  background-color: #3A1A1A;
}

.type-zone {
  color: #5DADE2;
  background-color: #1A2A3A;
}

.type-fidget {
  color: #F4D03F;
  background-color: #3A3A1A;
}

.item-duration {
  font-size: 13px;
  color: #FF9800;
}

.item-time {
  font-size: 12px;
  color: #888888;
  margin-top: 4px;
}

.btn-report {
  width: 100%;
  height: 44px;
  background-color: #534AB7;
  border-radius: 22px;
  justify-content: center;
  align-items: center;
  margin-top: 12px;
}

.btn-text {
  font-size: 16px;
  font-weight: bold;
  color: #ffffff;
}
</style>
