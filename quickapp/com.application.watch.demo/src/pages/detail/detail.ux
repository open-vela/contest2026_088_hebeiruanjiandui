<template>
  <div class="container">
    <text class="page-title">分心明细</text>

    <div class="summary">
      <text class="summary-text">专注 {{formatTime(totalTime)}}</text>
      <text class="summary-text">分心 {{distractionCount}} 次</text>
    </div>

    <text class="empty-tip" if="{{distractionCount === 0}}">本轮无分心记录，表现优秀！</text>

    <list class="distraction-list" if="{{distractionCount > 0}}">
      <list-item class="list-item" type="distraction" for="{{(index, item) in distractions}}">
        <div class="item-header">
          <text class="item-index">#{{index + 1}}</text>
          <text class="item-type {{item.type === 'zoning_out' ? 'type-zone' : (item.type === 'fidgeting' ? 'type-fidget' : 'type-physical')}}">{{getTypeLabel(item.type)}}</text>
          <text class="item-duration">{{item.duration}}秒</text>
        </div>
        <text class="item-time">{{item.start}} - {{item.end}}</text>
      </list-item>
    </list>

    <div class="btn-report" onclick="goReport">
      <text class="btn-text">查看分析报告</text>
    </div>
  </div>
</template>

<script>
import router from '@system.router'

export default {
  private: {
    totalTime: 0,
    distractionCount: 0,
    distractions: [],
    sessionStart: '',
    sessionEnd: '',
    mode: 'normal'
  },

  onInit() {
    var data = this.$app.$def.globalData.sessionData
    if (data) {
      this.totalTime = data.totalTime
      this.distractionCount = data.distractionCount
      this.distractions = data.distractions
      this.sessionStart = data.sessionStart
      this.sessionEnd = data.sessionEnd
      this.mode = data.mode
    }
  },

  formatTime(seconds) {
    var m = Math.floor(seconds / 60)
    var s = seconds % 60
    var mm = m < 10 ? '0' + m : '' + m
    var ss = s < 10 ? '0' + s : '' + s
    return mm + ':' + ss
  },

  getTypeLabel(type) {
    if (type === 'zoning_out') return '发呆走神'
    if (type === 'fidgeting') return '烦躁不安'
    return '物理性分心'
  },

  goReport() {
    router.push({ uri: '/pages/report' })
  }
}
</script>

